{
  "name": "praytime-monorepo",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "lint": "oxlint --deny-warnings packages apps",
    "changeset": "changeset",
    "version": "changeset version",
    "typecheck": "tsc --noEmit --project packages/praytime/tsconfig.json && tsc --noEmit --project apps/api/tsconfig.json"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.6",
    "typescript": "^5.9.3",
    "oxlint": "^1.93.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "@protobufjs/utf8": "^1.1.2",
    "brace-expansion": "^2.1.4",
    "esbuild": "^0.28.2",
    "lodash": "^4.18.1",
    "protobufjs": "^7.6.5",
    "rollup": "^4.62.5",
    "yaml": "^2.9.0"
  }
}
